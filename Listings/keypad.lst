   4          unsigned char Keypad_Scan() {
   5   1          unsigned char key_val = 0;
   6   1          // 只扫第4列 (S13-S16 所在的列，对应 P1.3)
   7   1          P1 = 0xF7; 
   8   1          if (P1 != 0xF7) { 
   9   2              Delay(10); 
  10   2              if (P1 != 0xF7) {
  11   3                  if ((P1 & 0x10) == 0) key_val = 1;  // S13 客厅
  12   3                  if ((P1 & 0x20) == 0) key_val = 2;  // S14 卧室
  13   3                  if ((P1 & 0x40) == 0) key_val = 3;  // S15 厨房
  14   3                  if ((P1 & 0x80) == 0) key_val = 4;  // S16 风扇
  15   3                  while (P1 != 0xF7 && key_val != 0); 
  16   3              }
  17   2          }
  18   1          P1 = 0xFF;
  19   1          return key_val;
  20   1      }


