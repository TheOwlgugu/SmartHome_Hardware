  87   2              buf[3] = '\r';
  88   2              buf[4] = '\n';
  89   2              buf[5] = '\0';
  90   2              UART_SendString(buf);
  91   2              return;
  92   2          }
  93   1      
  94   1          buf[3] = '\0';
  95   1          UART_SendString("AT+CIPSEND=");
  96   1          UART_SendByte(link_id);
  97   1          UART_SendString(",3\r\n");
  98   1          Delay(100);          /* 等 ESP 回 '>' */
  99   1          UART_SendString(buf);
 100   1          Delay(100);          /* 等 SEND OK */
 101   1      }
