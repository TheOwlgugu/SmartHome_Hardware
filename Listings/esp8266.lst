 117   2              if (rx_data >= '0' && rx_data <= '4') {
 118   3                  link_id = rx_data;
 119   3              }
 120   2              return;
 121   2          }
 122   1      
 123   1          if (rx_data == IPD_STR[ipd_pos]) {
 124   2              ipd_pos++;
